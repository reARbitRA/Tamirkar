# Runtime environment. `production` and `staging` both enable the strict checks: they refuse to
# boot with OTP_DEV_LOG_CODE=true. Any other value is treated as development.
NODE_ENV=production

# HTTP
PORT=8080
HOST=0.0.0.0
# Comma-separated production browser origins. Android native traffic does not need CORS.
ALLOWED_ORIGINS=https://app.example.com

# PostgreSQL (use the Compose default only for local development)
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://oosta_auth:change-this-local-password@localhost:5432/oosta_auth

# Generate distinct high-entropy values. Never put these values in the Android app.
JWT_SECRET=replace-with-openssl-rand-base64-48
OTP_PEPPER=replace-with-another-openssl-rand-base64-48

# Kavenegar Verify Lookup configuration.
# Create a template in Kavenegar first; it must accept the `token` variable.
KAVENEGAR_API_KEY=replace-with-kavenegar-api-key
KAVENEGAR_TEMPLATE=OOSTA_LOGIN

# AI gateway: disabled by default. This key is server-only.
FEATURE_AI_DIAGNOSIS=false
GEMINI_API_KEY=replace-with-server-only-gemini-key
GEMINI_MODEL=gemini-2.5-flash
# Every diagnosis is a billable provider call. This is the per-user ceiling per minute; the state
# is in-process, so on a multi-instance deployment the effective ceiling is limit x instances.
# Lower it if the monthly Gemini budget is tight.
AI_RATE_LIMIT_PER_MINUTE=10

# Every money or marketplace capability is fail-closed until separately approved.
FEATURE_NEW_BOOKINGS=false
FEATURE_PAYMENTS=false
FEATURE_TECHNICIAN_MATCHING=false
FEATURE_ESCROW_RELEASE=false
ZARINPAL_MERCHANT_ID=replace-with-zarinpal-merchant-id
ZARINPAL_SANDBOX=true
PAYMENT_CALLBACK_BASE_URL=https://api.example.com

# Development only. Keep false in every shared, staging, and production environment.
# When true, no SMS is sent and the generated OTP is only logged locally. The service refuses
# to boot if this is true while NODE_ENV is production or staging.
OTP_DEV_LOG_CODE=false

# Escrow release worker (src/escrow-worker.js). Invoke it from a scheduler; the API stays the
# single idempotent state-transition boundary. The token is a short-lived operator JWT.
PLATFORM_API_BASE_URL=https://api.example.com
ESCROW_WORKER_TOKEN=replace-with-a-short-lived-operator-jwt

# Outbound provider calls (Zarinpal, Kavenegar, Gemini) retry only on 429/5xx/network errors, with
# full-jitter backoff and a per-provider circuit breaker. A 4xx is a definite answer and is never
# re-sent. Raise this only if the provider is flaky and the added latency is acceptable.
PROVIDER_RETRY_ATTEMPTS=3

# OTP-challenge retention. Every login attempt writes an otp_challenges row; without a sweep the
# table accumulates a hashed phone number and a timestamp per attempt forever. `node src/retention.js
# run` deletes rows older than this that are no longer in flight (status not in pending/sending).
# Rows for a live login are never touched regardless of age.
OTP_RETENTION_DAYS=7

# Migration rollback guard. Every db/down/*.sql drops tables, so `node src/migrate.js down` refuses
# to run unless this is exactly `yes`. Take a restore point first. Never set this in a service
# environment - it is for an operator at a terminal.
# CONFIRM_DESTRUCTIVE_ROLLBACK=yes
