# HTTP
PORT=8080
HOST=0.0.0.0
# Comma-separated production origins. Android native traffic does not need CORS.
ALLOWED_ORIGINS=https://app.example.com

# PostgreSQL (use the Compose default only for local development)
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://oosta_auth:change-this-local-password@localhost:5432/oosta_auth

# Generate distinct high-entropy values. Never put these values in the Android app.
JWT_SECRET=replace-with-openssl-rand-base64-48
OTP_PEPPER=replace-with-another-openssl-rand-base64-48

# Kavenegar Verify Lookup configuration.
# Create a template in Kavenegar first; it must accept the `token` variable.
KAVENEGAR_API_KEY=replace-with-kavenegar-api-key
KAVENEGAR_TEMPLATE=OOSTA_LOGIN

# Development only. Keep false in every shared, staging, and production environment.
# When true, no SMS is sent and the generated OTP is only logged locally.
OTP_DEV_LOG_CODE=false
