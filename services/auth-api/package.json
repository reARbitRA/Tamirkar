{
  "name": "oosta-auth-api",
  "version": "0.1.0",
  "private": true,
  "description": "Small server-side OTP authentication API for Oosta using Kavenegar Verify Lookup.",
  "type": "module",
  "scripts": {
    "migrate": "node src/migrate.js",
    "migrate:rollback": "node src/migrate.js down 1",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "retention": "node src/retention.js run",
    "test:coverage": "node --test --experimental-test-coverage",
    "harness": "node ../../audit/harness/e2e.mjs",
    "harness:smoke": "node ../../audit/harness/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
