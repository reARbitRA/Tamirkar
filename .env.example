# AI provider keys (keep these server-side in production; never ship real keys in an APK)
GEMINI_API_KEY=MY_GEMINI_API_KEY
GROQ_API_KEY=MY_GROQ_API_KEY
CEREBRAS_API_KEY=MY_CEREBRAS_API_KEY
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY
HF_TOKEN=MY_HF_TOKEN

# Optional model overrides. Leave blank to use capability-specific defaults.
GEMINI_MODEL=
GROQ_MODEL=
CEREBRAS_MODEL=
OPENROUTER_MODEL=
OPENROUTER_VISION_MODEL=
HF_MODEL=

# Public HTTPS base URL of services/auth-api. This is not a secret.
# Use http://10.0.2.2:8080 only in a debug emulator build when developing locally.
AUTH_API_BASE_URL=https://auth.example.invalid
